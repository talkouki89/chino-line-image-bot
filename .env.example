# ============================================================
# Chino LINE Image Search Bot environment example
# 複製成 .env 後再填值。
#
# 標籤說明：
# [必填]      沒填通常無法正常啟動或無法使用核心功能。
# [選填]      只有使用對應功能時才需要。
# [不建議改動] 預設值已配合目前 CHRLINE-Patch；除非 API 壞掉或你知道用途，否則不要改。
# ============================================================

# ---------------- LINE 登入 / 管理 ----------------
# 登入優先順序：
# 1. 有填 LINE_AUTH_TOKEN 時，使用 auth token 登入。
# 2. 沒填 auth token，但有填 LINE_ACCOUNT / LINE_PASSWORD 時，使用帳號密碼登入。
# 3. 以上都沒填時，使用 SQR 掃碼登入。

# [選填] LINE auth token。也相容 LINE_AUTHTOKEN / BOT_AUTH_TOKEN。
LINE_AUTH_TOKEN=

# [選填] LINE 登入帳號。沒填 auth token 時才會使用。
LINE_ACCOUNT=

# [選填] LINE 登入密碼。需與 LINE_ACCOUNT 一起填寫。
LINE_PASSWORD=

# [必填] Bot 作者/最高管理員 MID。可先填自己的 MID。
Creator=

# [選填] 後台通知聊天室/群組 ID。登入、重啟、錯誤通知會發到這裡；不想收通知可留空。
Dio_GID=

# [選填] Bot 顯示名稱。留空會使用預設：智乃搜圖機器人🍥
BOT_DISPLAY_NAME=智乃搜圖機器人🍥

# [選填] Bot 個人簽名。留空會使用程式預設簽名。
BOT_STATUS_MESSAGE=使用請輸入 圖搜說明\nGitHub: https://github.com/talkouki89/chino-line-image-bot\n作者: 智乃妹妹

# [選填] 啟動時是否自動套用預設頭貼與封面。預設 true；不想自動替換可改 false。
AUTO_UPDATE_PROFILE_MEDIA=true

# [選填] 是否分別套用頭貼 / 封面。
AUTO_UPDATE_PROFILE_PHOTO=true
AUTO_UPDATE_PROFILE_COVER=true

# [選填] 預設頭貼與封面路徑。可填相對專案根目錄或絕對路徑。
PROFILE_PHOTO_PATH=pic/Profile photo.png
PROFILE_COVER_PATH=pic/cover photo.png

# [選填] Bot 顯示時間使用的時區。預設台灣時間，可填 Asia/Taipei、UTC+8、UTC-5。
BOT_TIMEZONE=Asia/Taipei

# [選填] 有人加 Bot 好友時自動傳送的訊息。可用 \n 換行。
AUTO_FRIEND_MESSAGE=感謝加入智乃搜圖機器人٩(ˊᗜˋ*)و\n\n可在私訊或群組中回覆圖片使用圖搜功能。\n\n使用方式：輸入「圖搜說明」查看指令\nGitHub：https://github.com/talkouki89/chino-line-image-bot\n\n遇到 bug 可以開 issue。\n想加新功能也歡迎發 PR (๑•̀ㅂ•́)و✧

# [選填] 新增好友事件時是否主動加對方好友。預設 false，降低帳號風控機率。
AUTO_FRIEND_ADD_CONTACT=false

# [選填] 啟動時是否傳送背景聊天室通知。頻繁重啟時建議 false，降低主動訊息量。
SEND_STARTUP_NOTIFY=false


# ---------------- 圖搜 API / PicImageSearch ----------------
# [選填] SauceNAO API key。使用「回覆搜1 / 模板搜1」建議填。
# 取得網址：https://saucenao.com/user.php?page=search-api
SauceNAO_api_key=

# [選填] PicImageSearch proxy，例如 http://127.0.0.1:7890。一般不用填。
PICSEARCH_PROXIES=

# [選填] PicImageSearch timeout 秒數。網路慢時可調高。
PICSEARCH_TIMEOUT=60

# [選填] 是否驗證 SSL。一般保持 true。
PICSEARCH_VERIFY_SSL=true

# [選填] Ascii2D 入口清單，逗號分隔。預設先走官方站；如果 Cloudflare 擋住，可自行加可用代理入口。
ASCII2D_BASE_URLS=https://ascii2d.net

# [選填] Yandex 入口清單，逗號分隔。yandex.com 目前可能回維護頁，預設改走 yandex.ru / ya.ru。
YANDEX_BASE_URLS=https://yandex.ru,https://ya.ru

# [選填] nHentai cookie。n:數字 / n:popular 多數情況可不填；遇到 403 或個人化結果再填。
NHENTAI_COOKIE=

# ---------------- 圖床 / 下載 / 外部服務 ----------------
# [選填] Freeimage.host API key。使用 #圖片上傳 時必填。
# API 說明：https://freeimage.host/page/api
FREEIMAGE_API_KEY=

# [選填] yt-dlp cookie 檔案路徑。下載 YouTube/X 等需要登入或年齡限制內容時使用。
YTDLP_COOKIES_FILE=cookies.txt

# [選填] 讓 yt-dlp 直接讀瀏覽器 cookie。下載需要登入或年齡限制內容時可填 chrome / edge / firefox。
# 也可以填 chrome,Default 這種格式指定瀏覽器設定檔。
YTDLP_COOKIES_FROM_BROWSER=

# [選填] YouTube 出現「Sign in to confirm you’re not a bot」時，是否自動嘗試讀取瀏覽器 cookie。
YTDLP_AUTO_BROWSER_COOKIES=true

# [選填] 自動嘗試的瀏覽器 cookie 來源；分號分隔多組，逗號可指定 profile。
YTDLP_AUTO_BROWSER_COOKIE_SOURCES=edge;chrome;firefox

# [選填] 直接貼 cookie 字串。IG / TikTok 圖片 fallback 解析時會使用。
YTDLP_COOKIE=

# [選填] Instaloader session 使用者名稱。若 IG 公開貼文抓不到，可先用 instaloader -l 使用者名稱 建立 session。
INSTALOADER_SESSION_USER=

# [選填] TikTok 圖片解析 API。預設使用 https://douyin.wtf，可改成自己部署的服務。
DOUYIN_WTF_API_BASE=https://douyin.wtf

# ---------------- 外掛系統 ----------------
# [選填] 是否啟用 plugins/ 熱載入。建議保持 true，改外掛不用重新登入。
HOT_RELOAD_PLUGINS=true

# [選填] 是否啟用最低入群人數限制。false 時不管群組人數多少都會加入。
GROUP_MIN_MEMBER_CHECK=true

# [選填] 最低入群人數。只有 GROUP_MIN_MEMBER_CHECK=true 且功能開關開啟時生效。
GROUP_MIN_MEMBERS=10


# ---------------- CHRLINE-Patch 低階設定 ----------------
# [不建議改動] LINE 裝置類型。改錯可能導致登入或 sync 失敗。
CHRLINE_DEVICE=DESKTOPWIN

# [不建議改動] LINE app version。留空使用 CHRLINE 預設。
CHRLINE_VERSION=

# [選填] CHRLINE debug log。排查 API 問題時才改 true。
CHRLINE_DEBUG=false

# [不建議改動] 是否使用 Thrift。
CHR_USE_THRIFT=True

# [不建議改動] CHRLINE 內部 TMore 行為。
CHR_TMORE_FORCE=False

# [不建議改動] LINE API domain。除非 LINE endpoint 改版或測試特殊環境，否則不要改。
LINE_HOST_DOMAIN=https://ga2.line.naver.jp
LINE_OBS_DOMAIN=https://obs.line-apps.com
LINE_API_DOMAIN=https://api.line.me
LINE_ACCESS_DOMAIN=https://access.line.me
LINE_BIZ_TIMELINE_DOMAIN=https://ga2.line.naver.jp/mh
